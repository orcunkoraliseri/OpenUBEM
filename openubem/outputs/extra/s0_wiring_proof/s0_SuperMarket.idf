SCHEDULE:COMPACT,
    OpenUBEM_DefrostSched_LowTemp,    !- Name
    ON/OFF,                   !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Interpolate: Average,     !- Field 3
    Until: 4:00,0,            !- Field 4
    Until: 4:20,1,            !- Field 5
    Until: 14:00,0,           !- Field 6
    Until: 14:20,1,           !- Field 7
    Until: 24:00,0;           !- Field 8


Program Version,EnergyPlus, Version 23.1.0-87ed9199d4, YMD=2026.06.26 21:41
! This file shows details about the branches, nodes, and other
! elements of the flow connections.
! This file is intended for use in "debugging" potential problems
! that may also be detected by the program, but may be more easily
! identified by "eye".
! This file is also intended to support software which draws a
! schematic diagram of the HVAC system.
! ===============================================================
! #Nodes,<Number of Unique Nodes>
 #Nodes,14
! <Node>,<NodeNumber>,<Node Name>,<Node Fluid Type>,<# Times Node Referenced After Definition>
 Node,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS AIR LOOP INLET,Air,3
 Node,2,BLOCK SUPERMARKET STOREY 0_PSZ_SYS MIXED AIR OUTLET,Air,7
 Node,3,BLOCK SUPERMARKET STOREY 0_PSZ_SYS AIR LOOP OUTLET,Air,5
 Node,4,BLOCK SUPERMARKET STOREY 0 ZONE AIR NODE,Air,1
 Node,5,BLOCK SUPERMARKET STOREY 0 SUPPLY INLET,Air,3
 Node,6,BLOCK SUPERMARKET STOREY 0 RETURN OUTLET,Air,1
 Node,7,BLOCK SUPERMARKET STOREY 0_PSZ_SYS SUPPLY PATH INLET,Air,2
 Node,8,BLOCK SUPERMARKET STOREY 0_PSZ_SYS RETURN AIR OUTLET,Air,2
 Node,9,BLOCK SUPERMARKET STOREY 0_PSZ_SYS OUTSIDE AIR INLET,Air,2
 Node,10,BLOCK SUPERMARKET STOREY 0_PSZ_SYS COOLING COIL CONDENSER INLET,Air,1
 Node,11,BLOCK SUPERMARKET STOREY 0_PSZ_SYS SUPPLY FAN OUTLET,Air,2
 Node,12,BLOCK SUPERMARKET STOREY 0 ZONE EQUIP INLET,Air,1
 Node,13,BLOCK SUPERMARKET STOREY 0_PSZ_SYS RELIEF AIR OUTLET,Air,1
 Node,14,BLOCK SUPERMARKET STOREY 0_PSZ_SYS HEATING COIL OUTLET,Air,1
! ===============================================================
! <#Branch Lists>,<Number of Branch Lists>
 #Branch Lists,1
! <Branch List>,<Branch List Count>,<Branch List Name>,<Loop Name>,<Loop Type>,<Number of Branches>
! <Branch>,<Branch Count>,<Branch Name>,<Loop Name>,<Loop Type>,<Branch Inlet Node Name>,<Branch Outlet Node Name>
 Branch List,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS BRANCHES,BLOCK SUPERMARKET STOREY 0_PSZ_SYS,Air,1
   Branch,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS MAIN BRANCH,BLOCK SUPERMARKET STOREY 0_PSZ_SYS,Air,BLOCK SUPERMARKET STOREY 0_PSZ_SYS AIR LOOP INLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS AIR LOOP OUTLET
! ===============================================================
! <#Supply Air Paths>,<Number of Supply Air Paths>
 #Supply Air Paths,1
! <Supply Air Path>,<Supply Air Path Count>,<Supply Air Path Name>,<AirLoopHVAC Name>
! <#Components on Supply Air Path>,<Number of Components>
! <Supply Air Path Component>,<Component Count>,<Component Type>,<Component Name>,<AirLoopHVAC Name>
! <#Outlet Nodes on Supply Air Path Component>,<Number of Nodes>
! <Supply Air Path Component Nodes>,<Node Count>,<Component Type>,<Component Name>,<Inlet Node Name>,<Outlet Node Name>,<AirLoopHVAC Name>
 Supply Air Path,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS SUPPLY PATH,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
   #Components on Supply Air Path,1
   Supply Air Path Component,1,AIRLOOPHVAC:ZONESPLITTER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS ZONE SPLITTER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
     #Outlet Nodes on Supply Air Path Component,1
     Supply Air Path Component Nodes,1,AIRLOOPHVAC:ZONESPLITTER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS ZONE SPLITTER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS SUPPLY PATH INLET,BLOCK SUPERMARKET STOREY 0 ZONE EQUIP INLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
! <#Nodes on Supply Air Path>,<Number of Nodes>
! <Supply Air Path Node>,<Node Type>,<Node Count>,<Node Name>,<AirLoopHVAC Name>
#Nodes on Supply Air Path,2
   Supply Air Path Node,Inlet Node,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS SUPPLY PATH INLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
   Supply Air Path Node,Outlet Node,2,BLOCK SUPERMARKET STOREY 0 ZONE EQUIP INLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
! ===============================================================
! <#Return Air Paths>,<Number of Return Air Paths>
 #Return Air Paths,1
! <Return Air Path>,<Return Air Path Count>,<Return Air Path Name>,<AirLoopHVAC Name>
! <#Components on Return Air Path>,<Number of Components>
! <Return Air Path Component>,<Component Count>,<Component Type>,<Component Name>,<AirLoopHVAC Name>
! <#Inlet Nodes on Return Air Path Component>,<Number of Nodes>
! <Return Air Path Component Nodes>,<Node Count>,<Component Type>,<Component Name>,<Inlet Node Name>,<Outlet Node Name>,<AirLoopHVAC Name>
 Return Air Path,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS RETURN PATH,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
   #Components on Return Air Path,1
   Return Air Path Component,1,AIRLOOPHVAC:ZONEMIXER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS ZONE MIXER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
     #Inlet Nodes on Return Air Path Component,1
     Return Air Path Component Nodes,1,AIRLOOPHVAC:ZONEMIXER,BLOCK SUPERMARKET STOREY 0_PSZ_SYS ZONE MIXER,BLOCK SUPERMARKET STOREY 0 RETURN OUTLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS RETURN AIR OUTLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
! <#Nodes on Return Air Path>,<Number of Nodes>
! <Return Air Path Node>,<Node Type>,<Node Count>,<Node Name>,<AirLoopHVAC Name>
   #Nodes on Return Air Path,2
   Return Air Path Node,Outlet Node,1,BLOCK SUPERMARKET STOREY 0_PSZ_SYS RETURN AIR OUTLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
   Return Air Path Node,Inlet Node,2,BLOCK SUPERMARKET STOREY 0 RETURN OUTLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS
! ===============================================================
! #Outdoor Air Nodes,<Number of Outdoor Air Nodes>
 #Outdoor Air Nodes,2
! <Outdoor Air Node>,<NodeNumber>,<Node Name>
 Outdoor Air Node,9,BLOCK SUPERMARKET STOREY 0_PSZ_SYS OUTSIDE AIR INLET
 Outdoor Air Node,10,BLOCK SUPERMARKET STOREY 0_PSZ_SYS COOLING COIL CONDENSER INLET
! ===============================================================
! <#Component Sets>,<Number of Component Sets>
 #Component Sets,7
! <Component Set>,<Component Set Count>,<Parent Object Type>,<Parent Object Name>,<Component Type>,<Component Name>,<Inlet Node ID>,<Outlet Node ID>,<Description>
 Component Set,1,BRANCH,BLOCK SUPERMARKET STOREY 0_PSZ_SYS MAIN BRANCH,AIRLOOPHVAC:OUTDOORAIRSYSTEM,BLOCK SUPERMARKET STOREY 0_PSZ_SYS OA SYSTEM,BLOCK SUPERMARKET STOREY 0_PSZ_SYS AIR LOOP INLET,BLOCK SUPERMARKET STOREY 0_PSZ_SYS MIXED AIR OUTLET,Air Nodes

    EU_floor_Construction,    !- Name
    EU_floor_NoMass;          !- Outside Layer

CONSTRUCTION,
    EU_Window_Construction,    !- Name
    EU_Window_SimpleGlazing;    !- Outside Layer

CONSTRUCTION,
    EU_InternalMass_Construction,    !- Name
    EU_InternalMass_Material;    !- Outside Layer

GlobalGeometryRules,
    UpperLeftCorner,          !- Starting Vertex Position
    CounterClockWise,         !- Vertex Entry Direction
    World;                    !- Coordinate System

ZONE,
    2f570cbf2c1841d0_F0_dwelling_0,    !- Name
    0,                        !- Direction of Relative North
    0,                        !- X Origin
    0,                        !- Y Origin
    0,                        !- Z Origin
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height
    142.433349609375,         !- Volume
    autocalculate,            !- Floor Area
    ,                         !- Zone Inside Convection Algorithm
    ,                         !- Zone Outside Convection Algorithm
    Yes;                      !- Part of Total Floor Area


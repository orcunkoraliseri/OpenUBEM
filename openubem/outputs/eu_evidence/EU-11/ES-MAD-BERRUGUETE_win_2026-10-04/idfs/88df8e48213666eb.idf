    ../../schedules/88df8e48213666eb/88df8e48213666eb_F0_dwelling_0_f000_gain.csv,    !- File Name
    1,                        !- Column Number
    0,                        !- Rows to Skip at Top
    8760,                     !- Number of Hours of Data

MATERIAL,
    EU_InternalMass_Material,    !- Name
    MediumRough,              !- Roughness
    0.1,                      !- Thickness
    1,                        !- Conductivity
    1800,                     !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.7794172923115091,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4354664641673787,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_floor_NoMass,          !- Name
    MediumRough,              !- Roughness
    0.5882217159957263,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance


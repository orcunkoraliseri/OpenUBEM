    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.9378813067869615,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.5485720851018077,       !- Thermal Resistance

    ebdb60d1b3656848_F0_dwelling_0,    !- Name
    0,                        !- Direction of Relative North
    0,                        !- X Origin
    0,                        !- Y Origin
    0,                        !- Z Origin
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height
    431.6429443359375,        !- Volume
    autocalculate,            !- Floor Area

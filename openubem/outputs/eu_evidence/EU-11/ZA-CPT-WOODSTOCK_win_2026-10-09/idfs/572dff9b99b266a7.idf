    572dff9b99b266a7_F0_dwelling_0,    !- Name
    0,                        !- Direction of Relative North
    0,                        !- X Origin
    0,                        !- Y Origin
    0,                        !- Z Origin
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height
    572.2979736328125,        !- Volume
    autocalculate,            !- Floor Area

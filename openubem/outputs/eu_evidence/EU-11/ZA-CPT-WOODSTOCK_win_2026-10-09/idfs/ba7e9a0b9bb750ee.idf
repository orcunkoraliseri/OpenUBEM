    0,                        !- Rows to Skip at Top
    8760,                     !- Number of Hours of Data
    Comma,                    !- Column Separator
    No,                       !- Interpolate to Timestep
    60,                       !- Minutes per Item
    Yes;                      !- Adjust Schedule for Daylight Savings

MATERIAL,
    EU_InternalMass_Material,    !- Name
    MediumRough,              !- Roughness
    0.1,                      !- Thickness
    1,                        !- Conductivity
    1800,                     !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4938759383642829,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4493816508484325,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_floor_NoMass,          !- Name
    MediumRough,              !- Roughness
    1.25,                     !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM,
    EU_Window_SimpleGlazing,    !- Name
    4.4,                      !- UFactor
    0.85,                     !- Solar Heat Gain Coefficient
    0.85;                     !- Visible Transmittance


!- Windows Line endings 

Version,
    23.1;                     !- Version Identifier

SimulationControl,
    Yes,                      !- Do Zone Sizing Calculation
    Yes,                      !- Do System Sizing Calculation
    Yes,                      !- Do Plant Sizing Calculation
    No,                       !- Run Simulation for Sizing Periods
    Yes,                      !- Run Simulation for Weather File Run Periods
    No,                       !- Do HVAC Sizing Simulation for Sizing Periods
    1;                        !- Maximum Number of HVAC Sizing Simulation Passes

Building,
    EU S2 Campaign,           !- Name
    0,                        !- North Axis
    City,                     !- Terrain
    ,                         !- Loads Convergence Tolerance Value
    ,                         !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    ,                         !- Maximum Number of Warmup Days
    ;                         !- Minimum Number of Warmup Days

ShadowCalculation,
    PolygonClipping,          !- Shading Calculation Method
    Periodic,                 !- Shading Calculation Update Frequency Method
    1;                        !- Shading Calculation Update Frequency

HeatBalanceAlgorithm,
    ConductionTransferFunction,    !- Algorithm
    200,                      !- Surface Temperature Upper Limit
    0.1,                      !- Minimum Surface Convection Heat Transfer Coefficient Value
    10000000;                 !- Maximum Surface Convection Heat Transfer Coefficient Value

Timestep,
    12;                       !- Number of Timesteps per Hour

Site:Location,
    Cape.Town.Intl.AP,        !- Name
    -33.965,                  !- Latitude
    18.602,                   !- Longitude
    2,                        !- Time Zone
    46;                       !- Elevation

SizingPeriod:WeatherFileDays,
    AnnualSizingPeriod,       !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    12,                       !- End Month
    31,                       !- End Day of Month
    Monday,                   !- Day of Week for Start Day
    No,                       !- Use Weather File Daylight Saving Period
    No;                       !- Use Weather File Rain and Snow Indicators

RunPeriod,
    RunPeriod1,               !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    ,                         !- Begin Year
    12,                       !- End Month
    31,                       !- End Day of Month
    ,                         !- End Year
    Sunday,                   !- Day of Week for Start Day
    No,                       !- Use Weather File Holidays and Special Days
    No,                       !- Use Weather File Daylight Saving Period
    No,                       !- Apply Weekend Holiday Rule
    Yes,                      !- Use Weather File Rain Indicators
    Yes;                      !- Use Weather File Snow Indicators

ScheduleTypeLimits,
    Any Number;               !- Name

SCHEDULETYPELIMITS,
    EU_Step8_AnyNumber_Wm2,    !- Name
    ,                         !- Lower Limit Value
    ,                         !- Upper Limit Value
    Continuous,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULE:CONSTANT,
    EU_AlwaysOn,              !- Name
    ,                         !- Schedule Type Limits Name
    1;                        !- Hourly Value

SCHEDULE:CONSTANT,
    EU_CoolingOff,            !- Name
    ,                         !- Schedule Type Limits Name
    0;                        !- Hourly Value

SCHEDULE:FILE,
    EU_Step8_GainSchedule_99b4279f417a3c1b_F0_dwelling_0_f000,    !- Name
    EU_Step8_AnyNumber_Wm2,    !- Schedule Type Limits Name
    ../../schedules/99b4279f417a3c1b/99b4279f417a3c1b_F0_dwelling_0_f000_gain.csv,    !- File Name
    1,                        !- Column Number
    0,                        !- Rows to Skip at Top
    8760,                     !- Number of Hours of Data
    Comma,                    !- Column Separator
    No,                       !- Interpolate to Timestep
    60,                       !- Minutes per Item
    Yes;                      !- Adjust Schedule for Daylight Savings

SCHEDULE:FILE,
    EU_Step8_GainSchedule_99b4279f417a3c1b_F1_dwelling_0_f000,    !- Name
    EU_Step8_AnyNumber_Wm2,    !- Schedule Type Limits Name
    ../../schedules/99b4279f417a3c1b/99b4279f417a3c1b_F1_dwelling_0_f000_gain.csv,    !- File Name
    1,                        !- Column Number
    0,                        !- Rows to Skip at Top
    8760,                     !- Number of Hours of Data
    Comma,                    !- Column Separator
    No,                       !- Interpolate to Timestep
    60,                       !- Minutes per Item
    Yes;                      !- Adjust Schedule for Daylight Savings

MATERIAL,
    EU_InternalMass_Material,    !- Name
    MediumRough,              !- Roughness
    0.1,                      !- Thickness
    1,                        !- Conductivity
    1800,                     !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4938759383642829,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4493816508484325,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_floor_NoMass,          !- Name
    MediumRough,              !- Roughness
    1.25,                     !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM,
    EU_Window_SimpleGlazing,    !- Name
    4.4,                      !- UFactor
    0.85,                     !- Solar Heat Gain Coefficient
    0.85;                     !- Visible Transmittance

CONSTRUCTION,
    EU_wall_Construction,     !- Name
    EU_wall_NoMass;           !- Outside Layer

CONSTRUCTION,
    EU_roof_Construction,     !- Name
    EU_roof_NoMass;           !- Outside Layer

CONSTRUCTION,
    EU_floor_Construction,    !- Name
    EU_floor_NoMass;          !- Outside Layer

CONSTRUCTION,
    EU_Window_Construction,    !- Name
    EU_Window_SimpleGlazing;    !- Outside Layer

CONSTRUCTION,
    EU_InternalMass_Construction,    !- Name
    EU_InternalMass_Material;    !- Outside Layer

GlobalGeometryRules,
    UpperLeftCorner,          !- Starting Vertex Position
    CounterClockWise,         !- Vertex Entry Direction
    World;                    !- Coordinate System


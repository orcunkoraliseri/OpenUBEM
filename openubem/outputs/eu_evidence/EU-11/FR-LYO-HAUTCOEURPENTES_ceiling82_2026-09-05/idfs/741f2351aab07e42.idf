SCHEDULE:CONSTANT,
    EU_AlwaysOn,              !- Name
    ,                         !- Schedule Type Limits Name
    1;                        !- Hourly Value

SCHEDULE:CONSTANT,
    EU_CoolingOff,            !- Name
    ,                         !- Schedule Type Limits Name
    0;                        !- Hourly Value


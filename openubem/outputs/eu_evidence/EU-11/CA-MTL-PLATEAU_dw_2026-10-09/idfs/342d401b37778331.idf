    EU_floor_NoMass;          !- Outside Layer

CONSTRUCTION,
    EU_Window_Construction,    !- Name
    EU_Window_SimpleGlazing;    !- Outside Layer

CONSTRUCTION,
    EU_InternalMass_Construction,    !- Name
    EU_InternalMass_Material;    !- Outside Layer


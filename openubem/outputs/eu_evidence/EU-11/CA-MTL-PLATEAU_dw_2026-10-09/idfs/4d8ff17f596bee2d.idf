    4d8ff17f596bee2d_F0_dwelling_0,    !- Name
    0,                        !- Direction of Relative North
    0,                        !- X Origin
    0,                        !- Y Origin
    0,                        !- Z Origin
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height
    227.767822265625,         !- Volume
    autocalculate,            !- Floor Area

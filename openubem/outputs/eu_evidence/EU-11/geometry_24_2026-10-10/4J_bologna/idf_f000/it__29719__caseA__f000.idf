MATERIAL,
    EU_InternalMass_Material,    !- Name
    MediumRough,              !- Roughness
    0.1,                      !- Thickness {m}
    1,                        !- Conductivity {W/m-K}
    1800,                     !- Density {kg/m3}
    900,                      !- Specific Heat {J/kg-K}
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.9058281353670552,       !- Thermal Resistance {m2-K/W}
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    3.759304e-01,             !- Thermal Resistance {m2-K/W}
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_floor_NoMass,          !- Name
    MediumRough,              !- Roughness
    0.6711395814079611,       !- Thermal Resistance {m2-K/W}
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

CONSTRUCTION,
    EU_wall_Construction,     !- Name
    EU_wall_NoMass;           !- Outside Layer

CONSTRUCTION,
    EU_roof_Construction,     !- Name
    EU_roof_NoMass;           !- Outside Layer

CONSTRUCTION,
    EU_floor_Construction,    !- Name
    EU_floor_NoMass;          !- Outside Layer

CONSTRUCTION,
    EU_InternalMass_Construction,    !- Name
    EU_InternalMass_Material;    !- Outside Layer

GlobalGeometryRules,
    UpperLeftCorner,          !- Starting Vertex Position
    CounterClockWise,         !- Vertex Entry Direction
    World;                    !- Coordinate System

ZONE,
    29719_F0_dwelling_0,      !- Name
    0,                        !- Direction of Relative North {deg}
    0,                        !- X Origin {m}
    0,                        !- Y Origin {m}
    0,                        !- Z Origin {m}
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height {m}
    148.62744140625,          !- Volume {m3}
    autocalculate,            !- Floor Area {m2}
    ,                         !- Zone Inside Convection Algorithm
    ,                         !- Zone Outside Convection Algorithm
    Yes;                      !- Part of Total Floor Area

ZONE,
    29719_F1_dwelling_0,      !- Name
    0,                        !- Direction of Relative North {deg}
    0,                        !- X Origin {m}
    0,                        !- Y Origin {m}
    0,                        !- Z Origin {m}
    1,                        !- Type
    1,                        !- Multiplier
    autocalculate,            !- Ceiling Height {m}
    148.628173828125,         !- Volume {m3}
    autocalculate,            !- Floor Area {m2}
    ,                         !- Zone Inside Convection Algorithm
    ,                         !- Zone Outside Convection Algorithm
    Yes;                      !- Part of Total Floor Area

ZONE,

    EU_wall_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.7764936135936589,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_roof_NoMass,           !- Name
    MediumRough,              !- Roughness
    0.4868932610609646,       !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    EU_floor_NoMass,          !- Name

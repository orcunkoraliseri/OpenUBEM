    SET_Perimeter_ZN_2_Light_EMS_Program;    !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    SET_Perimeter_ZN_3_Light_EMS_Program_Prog_Manager,    !- Name
    BeginTimestepBeforePredictor,    !- EnergyPlus Model Calling Point
    SET_Perimeter_ZN_3_Light_EMS_Program;    !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    SET_Perimeter_ZN_4_Light_EMS_Program_Prog_Manager,    !- Name
    BeginTimestepBeforePredictor,    !- EnergyPlus Model Calling Point
    SET_Perimeter_ZN_4_Light_EMS_Program;    !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Core_ZN_Light_EMS_Program,    !- Name
    SET Core_ZN_LSr_IP=0.093*Core_ZN_LSr/Core_ZN_Area,    !- Program Line 1
    IF (Core_ZN_Occ_Sensor <= 0) && (Core_ZN_LSr_IP >= 0.02),    !- Program Line 2
    SET Core_ZN_Light_Actuator = 0.02*Core_ZN_Area/0.09290304,    !- Program Line 3
    ELSE,                     !- Program Line 4
    SET Core_ZN_Light_Actuator = NULL,    !- Program Line 5
    ENDIF;                    !- Program Line 6

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_1_Light_EMS_Program,    !- Name
    SET Perimeter_ZN_1_LSr_IP=0.093*Perimeter_ZN_1_LSr/Perimeter_ZN_1_Area,    !- Program Line 1
    IF (Perimeter_ZN_1_Occ_Sensor <= 0) && (Perimeter_ZN_1_LSr_IP >= 0.02),    !- Program Line 2
    SET Perimeter_ZN_1_Light_Actuator = 0.02*Perimeter_ZN_1_Area/0.09290304,    !- Program Line 3
    ELSE,                     !- Program Line 4
    SET Perimeter_ZN_1_Light_Actuator = NULL,    !- Program Line 5
    ENDIF;                    !- Program Line 6

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_2_Light_EMS_Program,    !- Name
    SET Perimeter_ZN_2_LSr_IP=0.093*Perimeter_ZN_2_LSr/Perimeter_ZN_2_Area,    !- Program Line 1
    IF (Perimeter_ZN_2_Occ_Sensor <= 0) && (Perimeter_ZN_2_LSr_IP >= 0.02),    !- Program Line 2
    IF (ActualOccupancy <= 0),    !- Program Line 3
    SET Perimeter_ZN_2_Light_Actuator = 0.02*Perimeter_ZN_2_Area/0.09290304,    !- Program Line 4
    ELSE,                     !- Program Line 5
    SET Perimeter_ZN_2_Light_Actuator = NULL,    !- Program Line 6
    ENDIF,                    !- Program Line 7
    ELSE,                     !- Program Line 8
    SET Perimeter_ZN_2_Light_Actuator = NULL,    !- Program Line 9
    ENDIF;                    !- Program Line 10

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_3_Light_EMS_Program,    !- Name
    SET Perimeter_ZN_3_LSr_IP=0.093*Perimeter_ZN_3_LSr/Perimeter_ZN_3_Area,    !- Program Line 1
    IF (Perimeter_ZN_3_Occ_Sensor <= 0) && (Perimeter_ZN_3_LSr_IP >= 0.02),    !- Program Line 2
    SET Perimeter_ZN_3_Light_Actuator = 0.02*Perimeter_ZN_3_Area/0.09290304,    !- Program Line 3
    ELSE,                     !- Program Line 4
    SET Perimeter_ZN_3_Light_Actuator = NULL,    !- Program Line 5
    ENDIF;                    !- Program Line 6

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_4_Light_EMS_Program,    !- Name
    SET Perimeter_ZN_4_LSr_IP=0.093*Perimeter_ZN_4_LSr/Perimeter_ZN_4_Area,    !- Program Line 1

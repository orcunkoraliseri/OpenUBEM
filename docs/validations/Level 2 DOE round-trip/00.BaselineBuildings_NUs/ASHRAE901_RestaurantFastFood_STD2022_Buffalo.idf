    SET_Kitchen_Light_EMS_Program;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Dining_Light_EMS_Program,
    SET Dining_LSr_IP=0.093*Dining_LSr/Dining_Area,
    IF (Dining_Occ_Sensor <= 0) && (Dining_LSr_IP >= 0.02),
    SET Dining_Light_Actuator = 0.02*Dining_Area/0.09290304,
    ELSE,
    SET Dining_Light_Actuator = NULL,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Kitchen_Light_EMS_Program,
    SET Kitchen_LSr_IP=0.093*Kitchen_LSr/Kitchen_Area,
    IF (Kitchen_Occ_Sensor <= 0) && (Kitchen_LSr_IP >= 0.02),
    SET Kitchen_Light_Actuator = 0.02*Kitchen_Area/0.09290304,
    ELSE,
    SET Kitchen_Light_Actuator = NULL,
    ENDIF;


    ELSE,                     !- Program Line 6
    SET vav_other_MAX_OA_FRAC = NULL,    !- Program Line 7
    ENDIF,                    !- Program Line 8
    ENDIF;                    !- Program Line 9

EnergyManagementSystem:Program,
    OA_BASED_OPTIMUM_START_EMS_Program,    !- Name
    IF DaylightSavings==0 && DayOfWeek>1 && DayOfWeek<>7 && Hour==6 && OAT<23.9 && OAT>1.7,    !- Program Line 1
    SET CLGSETP_SCH_Actuator = 26.7,    !- Program Line 2
    SET HTGSETP_SCH_Actuator = 15.6,    !- Program Line 3
    SET CLGSETP_SCH_w_SB_Actuator = 26.7,    !- Program Line 4
    SET HTGSETP_SCH_w_SB_Actuator = 15.6,    !- Program Line 5
    ELSEIF DaylightSavings==1 && DayOfWeek>1 && DayOfWeek<>7 && Hour==5 && OAT<23.9 && OAT>1.7,    !- Program Line 6
    SET CLGSETP_SCH_Actuator = 26.7,    !- Program Line 7
    SET HTGSETP_SCH_Actuator = 15.6,    !- Program Line 8
    SET CLGSETP_SCH_w_SB_Actuator = 26.7,    !- Program Line 9
    SET HTGSETP_SCH_w_SB_Actuator = 15.6,    !- Program Line 10
    ELSE,                     !- Program Line 11
    SET CLGSETP_SCH_Actuator = NULL,    !- Program Line 12
    SET HTGSETP_SCH_Actuator = NULL,    !- Program Line 13
    SET CLGSETP_SCH_w_SB_Actuator = NULL,    !- Program Line 14
    SET HTGSETP_SCH_w_SB_Actuator = NULL,    !- Program Line 15
    ENDIF;                    !- Program Line 16

EnergyManagementSystem:Program,
    SetBoilerPar,             !- Name
    SET CapRated =  443443.76,    !- Program Line 1
    SET EtRated =  0.945,     !- Program Line 2
    SET CapRated = (CapRated *3.412)/1000,    !- Program Line 3
    SET SkinLossRate = 0.02,    !- Program Line 4
    SET BoilerType = 1,       !- Program Line 5
    IF BoilerType  == 1,      !- Program Line 6
    IF CapRated >10000,       !- Program Line 7
    SET PLRx = 0.2,           !- Program Line 8
    ELSEIF CapRated >5000,    !- Program Line 9
    SET PLRx = 0.25,          !- Program Line 10
    ELSEIF CapRated >1000,    !- Program Line 11
    SET PLRx = 0.33,          !- Program Line 12
    ELSE,                     !- Program Line 13
    SET BoilerType = 2,       !- Program Line 14
    SET PLRx = 0.2,           !- Program Line 15
    ENDIF,                    !- Program Line 16
    ELSE,                     !- Program Line 17
    SET PLRx = 0.2,           !- Program Line 18
    ENDIF,                    !- Program Line 19
    IF BoilerType == 1,       !- Program Line 20
    SET CurveX = 0.975 + 0.305 * PLRx - 0.527 * (PLRx^2) + 0.249 * (PLRx^3),    !- Program Line 21
    ELSEIF BoilerType == 2,    !- Program Line 22
    SET CurveX = 0.907 + 0.320 * PLRx - 0.420 * (PLRx^2) + 0.193 * (PLRx^3),    !- Program Line 23
    ELSE,                     !- Program Line 24
    SET CurveX = 0.492 + 1.41 * PLRx - 1.529 * (PLRx^2) + 0.628 * (PLRx^3),    !- Program Line 25
    ENDIF,                    !- Program Line 26
    SET LoadX = CapRated * PLRx,    !- Program Line 27
    SET Etx = CurveX * EtRated,    !- Program Line 28
    SET InputEx = LoadX/Etx,    !- Program Line 29
    SET SkinEx = CapRated * SkinLossRate,    !- Program Line 30
    SET Ecx = (LoadX + SkinEx)/InputEx;    !- Program Line 31

EnergyManagementSystem:Program,
    SetBoilerCurve,           !- Name
    IF BoilerPLR >= PLRx,     !- Program Line 1
    IF BoilerType == 1,       !- Program Line 2
    SET BoilerCurve = 0.975 + 0.305*BoilerPLR - 0.527*(BoilerPLR^2) + 0.249*(BoilerPLR^3),    !- Program Line 3
    ELSEIF BoilerType == 2,    !- Program Line 4
    SET BoilerCurve = 0.907 + 0.320*BoilerPLR - 0.420*(BoilerPLR^2) + 0.193*(BoilerPLR^3),    !- Program Line 5
    ELSE,                     !- Program Line 6
    SET BoilerCurve = 0.492 + 1.41*BoilerPLR - 1.529*(BoilerPLR^2) + 0.628*(BoilerPLR^3),    !- Program Line 7
    ENDIF,                    !- Program Line 8
    ELSE,                     !- Program Line 9
    IF BoilerPLR == 0,        !- Program Line 10
    SET BoilerCurve = NULL,    !- Program Line 11
    ELSE,                     !- Program Line 12
    IF BoilerPLR <0.05,       !- Program Line 13
    SET BoilerCurve = (0.05/(0.05 + SkinLossRate)) * (Ecx/EtRated),    !- Program Line 14
    ELSE,                     !- Program Line 15
    SET BoilerCurve = (BoilerPLR/(BoilerPLR + SkinLossRate)) * (Ecx/EtRated),    !- Program Line 16
    ENDIF,                    !- Program Line 17
    ENDIF,                    !- Program Line 18
    ENDIF;                    !- Program Line 19

EnergyManagementSystem:GlobalVariable,
    Wired_LTG;                !- Erl Variable 1 Name

EnergyManagementSystem:GlobalVariable,

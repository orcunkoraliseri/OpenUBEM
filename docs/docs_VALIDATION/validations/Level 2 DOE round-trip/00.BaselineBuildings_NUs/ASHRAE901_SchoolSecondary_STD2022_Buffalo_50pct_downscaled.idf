EnergyManagementSystem:Program,
    vav_pod_1_MAX_OA_FRAC,    !- Name
    IF vav_pod_1_OA > vav_pod_1_OA_VRP,    !- Program Line 1
    SET vav_pod_1_MAX_OA_FRAC = NULL,    !- Program Line 2
    ELSE,                     !- Program Line 3
    IF vav_pod_1_SUPPLY_FLOW > 0,    !- Program Line 4
    SET vav_pod_1_MAX_OA_FRAC =      7.5948 / vav_pod_1_SUPPLY_FLOW,    !- Program Line 5
    ELSE,                     !- Program Line 6
    SET vav_pod_1_MAX_OA_FRAC = NULL,    !- Program Line 7
    ENDIF,                    !- Program Line 8
    ENDIF;                    !- Program Line 9


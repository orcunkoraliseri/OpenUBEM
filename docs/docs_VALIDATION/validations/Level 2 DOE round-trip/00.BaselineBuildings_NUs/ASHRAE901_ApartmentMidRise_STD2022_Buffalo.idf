ENERGYMANAGEMENTSYSTEM:SENSOR,
    S_Sliding_Door_Ventilation_Sensor,
    M S1 APARTMENT,
    Zone Ventilation Standard Density Volume Flow Rate;

ENERGYMANAGEMENTSYSTEM:SENSOR,
    N_Sliding_Door_Ventilation_Sensor,
    M N1 APARTMENT,
    Zone Ventilation Standard Density Volume Flow Rate;

ENERGYMANAGEMENTSYSTEM:ACTUATOR,
    S_LivingUnit_CLGSETP_Actuator,
    S CLGSETP_APT_SCH,
    Schedule:Compact,
    Schedule Value;

ENERGYMANAGEMENTSYSTEM:ACTUATOR,
    S_LivingUnit_HTGSETP_Actuator,
    S HTGSETP_APT_SCH,
    Schedule:Compact,
    Schedule Value;

ENERGYMANAGEMENTSYSTEM:ACTUATOR,
    N_LivingUnit_CLGSETP_Actuator,
    N CLGSETP_APT_SCH,
    Schedule:Compact,
    Schedule Value;

ENERGYMANAGEMENTSYSTEM:ACTUATOR,
    N_LivingUnit_HTGSETP_Actuator,
    N HTGSETP_APT_SCH,
    Schedule:Compact,
    Schedule Value;

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Door_Switch_Enabled_Thermostat_Reset,
    BeginTimestepBeforePredictor,
    Door_Switch_Enabled_Thermostat_Reset_Program_N_LivingUnit,
    Door_Switch_Enabled_Thermostat_Reset_Program_S_LivingUnit;

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    init_timesteps_after_doorshut_south_Program Manager,
    BeginNewEnvironment,
    init_timesteps_after_doorshut;

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    timesteps_after_doorshut_south;

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    timesteps_after_doorshut_north;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    init_timesteps_after_doorshut,
    SET timesteps_after_doorshut_south = 0,
    SET timesteps_after_doorshut_north = 0;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    Door_Switch_Enabled_Thermostat_Reset_Program_S_LivingUnit,
    IF (S_Sliding_Door_Ventilation_Sensor > 0),
    SET timesteps_after_doorshut_south = 0,
    SET S_LivingUnit_CLGSETP_Actuator = 32.22,
    SET S_LivingUnit_HTGSETP_Actuator = 12.78,
    ELSEIF S_LivingUnit_CLGSETP_Actuator > 24.4,
    SET timesteps_after_doorshut_south = timesteps_after_doorshut_south + 1,
    IF timesteps_after_doorshut_south == 1,
    SET S_LivingUnit_CLGSETP_Actuator = 30,
    SET S_LivingUnit_HTGSETP_Actuator = 14,
    ELSEIF timesteps_after_doorshut_south == 2,
    SET S_LivingUnit_CLGSETP_Actuator = 28,
    SET S_LivingUnit_HTGSETP_Actuator = 16,
    ELSEIF timesteps_after_doorshut_south == 3,
    SET S_LivingUnit_CLGSETP_Actuator = 26,
    SET S_LivingUnit_HTGSETP_Actuator = 18,
    ELSEIF timesteps_after_doorshut_south == 4,
    SET S_LivingUnit_CLGSETP_Actuator = 25,
    SET S_LivingUnit_HTGSETP_Actuator = 20,
    SET S_LivingUnit_CLGSETP_Actuator = null,
    SET S_LivingUnit_HTGSETP_Actuator = null,
    ENDIF,
    ELSE,
    SET timesteps_after_doorshut_south = 0,
    SET S_LivingUnit_CLGSETP_Actuator = null,
    SET S_LivingUnit_HTGSETP_Actuator = null,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    Door_Switch_Enabled_Thermostat_Reset_Program_N_LivingUnit,
    IF (N_Sliding_Door_Ventilation_Sensor > 0),
    SET timesteps_after_doorshut_north = 0,
    SET N_LivingUnit_CLGSETP_Actuator = 32.22,
    SET N_LivingUnit_HTGSETP_Actuator = 12.78,
    ELSEIF N_LivingUnit_CLGSETP_Actuator > 24.4,
    SET timesteps_after_doorshut_north = timesteps_after_doorshut_north + 1,
    IF timesteps_after_doorshut_north == 1,
    SET N_LivingUnit_CLGSETP_Actuator = 30,
    SET N_LivingUnit_HTGSETP_Actuator = 14,
    ELSEIF timesteps_after_doorshut_north == 2,
    SET N_LivingUnit_CLGSETP_Actuator = 28,
    SET N_LivingUnit_HTGSETP_Actuator = 16,
    ELSEIF timesteps_after_doorshut_north == 3,
    SET N_LivingUnit_CLGSETP_Actuator = 26,
    SET N_LivingUnit_HTGSETP_Actuator = 18,
    ELSEIF timesteps_after_doorshut_north == 4,
    SET N_LivingUnit_CLGSETP_Actuator = 25,
    SET N_LivingUnit_HTGSETP_Actuator = 20,
    SET N_LivingUnit_CLGSETP_Actuator = null,
    SET N_LivingUnit_HTGSETP_Actuator = null,
    ENDIF,
    ELSE,
    SET timesteps_after_doorshut_north = 0,
    SET N_LivingUnit_CLGSETP_Actuator = null,
    SET N_LivingUnit_HTGSETP_Actuator = null,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    timesteps_after_doorshut_south,
    timesteps_after_doorshut_south,
    Averaged,
    ZoneTimeStep,
    ,
    ;

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    timesteps_after_doorshut_north,
    timesteps_after_doorshut_north,
    Averaged,
    ZoneTimeStep,
    ,
    ;

OUTPUT:METER:METERFILEONLY,
    Electricity:Facility,
    Hourly;

OUTPUT:METER:METERFILEONLY,
    ElectricityNet:Facility,
    Hourly;

OUTPUT:METER:METERFILEONLY,
    Gas:Facility,
    Hourly;


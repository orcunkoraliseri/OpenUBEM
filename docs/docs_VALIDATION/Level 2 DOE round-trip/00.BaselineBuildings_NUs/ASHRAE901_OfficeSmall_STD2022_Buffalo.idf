ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Core_ZN_Light_EMS_Program,
    SET Core_ZN_LSr_IP=0.093*Core_ZN_LSr/Core_ZN_Area,
    IF (Core_ZN_Occ_Sensor <= 0) && (Core_ZN_LSr_IP >= 0.02),
    SET Core_ZN_Light_Actuator = 0.02*Core_ZN_Area/0.09290304,
    ELSE,
    SET Core_ZN_Light_Actuator = NULL,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_1_Light_EMS_Program,
    SET Perimeter_ZN_1_LSr_IP=0.093*Perimeter_ZN_1_LSr/Perimeter_ZN_1_Area,
    IF (Perimeter_ZN_1_Occ_Sensor <= 0) && (Perimeter_ZN_1_LSr_IP >= 0.02),
    SET Perimeter_ZN_1_Light_Actuator = 0.02*Perimeter_ZN_1_Area/0.09290304,
    ELSE,
    SET Perimeter_ZN_1_Light_Actuator = NULL,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_2_Light_EMS_Program,
    SET Perimeter_ZN_2_LSr_IP=0.093*Perimeter_ZN_2_LSr/Perimeter_ZN_2_Area,
    IF (Perimeter_ZN_2_Occ_Sensor <= 0) && (Perimeter_ZN_2_LSr_IP >= 0.02),
    IF (ActualOccupancy <= 0),
    SET Perimeter_ZN_2_Light_Actuator = 0.02*Perimeter_ZN_2_Area/0.09290304,
    ELSE,
    SET Perimeter_ZN_2_Light_Actuator = NULL,
    ENDIF,
    ELSE,
    SET Perimeter_ZN_2_Light_Actuator = NULL,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_3_Light_EMS_Program,
    SET Perimeter_ZN_3_LSr_IP=0.093*Perimeter_ZN_3_LSr/Perimeter_ZN_3_Area,
    IF (Perimeter_ZN_3_Occ_Sensor <= 0) && (Perimeter_ZN_3_LSr_IP >= 0.02),
    SET Perimeter_ZN_3_Light_Actuator = 0.02*Perimeter_ZN_3_Area/0.09290304,
    ELSE,
    SET Perimeter_ZN_3_Light_Actuator = NULL,
    ENDIF;

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    SET_Perimeter_ZN_4_Light_EMS_Program,
    SET Perimeter_ZN_4_LSr_IP=0.093*Perimeter_ZN_4_LSr/Perimeter_ZN_4_Area,
